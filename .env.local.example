# ─────────────────────────────────────────────────────────────────
# Frontend environment variables
# Copy this file to BOTH locations:
#   frontend/.env.local  ← Vite reads this for local dev (required)
#   .env.local           ← keep in sync for reference
# Both are gitignored — never commit real credentials.
# ─────────────────────────────────────────────────────────────────

# Local dev: direct proxy mode (no backend needed)
# Set your raw API credentials here. Vite injects them server-side
# via the dev proxy — they never appear in the browser bundle.
VITE_HUBSPOT_ACCESS_TOKEN=
VITE_PENDO_INTEGRATION_KEY=

# Production / SAM local: point at your API Gateway or sam local start-api
# When this is set, the app routes all calls through the Lambda proxy instead.
VITE_API_BASE_URL=

# ─────────────────────────────────────────────────────────────────
# GitHub Actions secrets (set in repo Settings → Secrets → Actions)
# ─────────────────────────────────────────────────────────────────
# VITE_API_BASE_URL          → API Gateway URL after first backend deploy
# AWS_DEPLOY_ROLE_ARN        → IAM role ARN for OIDC (no long-lived keys needed)
# AWS_REGION                 → e.g. us-east-1
# S3_BUCKET_NAME             → S3 bucket for frontend static files
# CLOUDFRONT_DISTRIBUTION_ID → CloudFront distribution in front of S3
# SAM_ARTIFACTS_BUCKET       → S3 bucket SAM uses to upload Lambda packages
# FRONTEND_ORIGIN            → CloudFront URL e.g. https://d1234.cloudfront.net
#
# Lambda env vars (SAM parameter overrides — never touch the frontend bundle):
# HUBSPOT_ACCESS_TOKEN
# PENDO_API_KEY
# GA4_PROPERTY_ID
# GA4_API_SECRET
